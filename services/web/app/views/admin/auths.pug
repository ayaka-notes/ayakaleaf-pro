extends ../layout-marketing

block content
	#main-content.content.content-alt
		.container
			.row
				.col-sm-12
					.card
						.card-body
							.page-header
								h1 #{title}

							if message
								.alert.alert-success #{message}
							if error
								.alert.alert-danger #{error}

							if !form
								// ---------------- provider list ----------------
								p
									| SSO sources (OIDC providers and SAML IdPs) and their profile
									| filters. Each source gets its own button on the login page.
									| Profiles are checked against the filter on every login:
									| deny rules block, allow rules (when set) require a match.
									| Existing accounts
									strong (allowExistingUsers)
									| and invited collaborators
									strong (allowInvited)
									| can be exempted per source.
								if file
									p.text-muted
										| The file-based providers are stored in
										code #{file}
										| — you can edit that file directly and save it here (or restart the server).
								else
									p.text-muted
										| No provider file is configured yet. Create a provider below; it will
										| be written to
										code config/ssos.providers.json
										| (override with
										code OVERLEAF_SSO_PROVIDERS_FILE
										| ).
								.row-spaced
									ul.list-inline
										li.list-inline-item
											a.btn.btn-secondary(href='/admin/auths/new?type=saml') New SAML IdP
										li.list-inline-item
											a.btn.btn-secondary(href='/admin/auths/new?type=saml&preset=edugain') New SAML IdP (EduGAIN preset)
										li.list-inline-item
											a.btn.btn-secondary(href='/admin/auths/new?type=oidc') New OIDC provider
										li.list-inline-item
											a.btn.btn-secondary(href='/admin/auths/new?type=oidc&preset=edugain') New OIDC provider (EduGAIN preset)
								if !providers.length
									p No SSO sources configured yet.
								.table
									thead
										tr
											th Name
											th Type
											th ID
											th Filter
											th Enabled
											th Source
											th Actions
									tbody
										each provider in providers
											tr
												td #{provider.name}
												td #{provider.type.toUpperCase()}
												td code #{provider.id}
												td
													if provider.filter.deny.length || provider.filter.allow.length
														| #{provider.filter.deny.length} deny / #{provider.filter.allow.length} allow
													else
														| none
												td
													if provider.source !== 'env'
														form(method='post' action=`/admin/auths/${provider.id}/toggle`)
															input(name='_csrf' type='hidden' value=csrfToken)
															input(type='checkbox' checked=provider.enabled)
													else
														| —
												td #{provider.source}
												td
													if provider.source !== 'env'
														a(href=`/admin/auths/${provider.id}/edit`) Edit
														form(method='post' action=`/admin/auths/${provider.id}/delete` onsubmit="return confirm('Delete this SSO source? Users linked to it keep their accounts, but this source is no longer offered on the login page.')")
															input(name='_csrf' type='hidden' value=csrfToken)
															button.btn.btn-sm.btn-danger(type='submit') Delete
													else
														| env

							if form
								// ---------------- new / edit form ----------------
								if form.readOnly
									.alert.alert-info
										| This provider comes from legacy environment variables
										| (
										code EXTERNAL_AUTH
										| +
										code OVERLEAF_OIDC_*
										| /
										code OVERLEAF_SAML_*
										| ). Change the environment to modify it, or create a file-based
										| provider with a different id (the file version then wins).
								if !form.readOnly
									form(method='post' action=(form.mode === 'new' ? '/admin/auths' : `/admin/auths/${form.id}`))
										input(name='_csrf' type='hidden' value=csrfToken)
										input(type='hidden' name='mode' value=form.mode)
										if form.mode === 'new'
											p.form-text
												Preset templates:
												ul
													li SAML — <a href='/admin/auths/new?type=saml'>blank</a> / <a href='/admin/auths/new?type=saml&preset=edugain'>EduGAIN</a>
													li OIDC — <a href='/admin/auths/new?type=oidc'>blank</a> / <a href='/admin/auths/new?type=oidc&preset=edugain'>EduGAIN</a>
										.form-group
											label.form-label(for='config') Provider configuration (JSON)
											p.form-text
												|
												| The provider is validated server-side before it is saved.
												| The
												code attrs
												| section maps profile fields to user fields;
												code filter.allow
												| /
												code filter.deny
												| hold the profile filter rules;
												code filter.allowExistingUsers
												| and
												code filter.allowInvited
												| are the exceptions for existing accounts and invited collaborators.
											textarea#config.form-control.config-editor(
												name='config'
												rows='24'
												spellcheck='false'
											) #{form.json}
										.d-flex
											button.btn.btn-primary.ms-2(type='submit') Save provider
											a.btn.ms-2(href='/admin/auths') Cancel

								// ---------------- reference ----------------
								hr
								h5 Reference
								h6 Attribute names (filter fields)
								p.text-muted
									| Any attribute or claim name can be used — the list below is a guide for the
									| common and eduGAIN (GN3-11-012) ones.
								table.table.table-sm
									thead
										tr
											th Attribute
											th Description
									tbody
										each attribute in catalog
											tr
												td code #{attribute.name}
												td #{attribute.description}
													if attribute.values
														br
														| Allowed values:
														code #{attribute.values.join(', ')}
								h6 Filter operators
								p
									code #{ops.join('  ')}
								p.text-muted
									| Rule:
									code { "field": "eduPersonScopedAffiliation", "op": "iEndsWith", "value": "@uni-bremen.de" }
									| — with
									code op
									| =
									code oneOf
									| /
									code iOneOf
									| the matched entries are given in
									code values
									| . A
									code deny
									| rule matching blocks login; if
									code allow
									| is non-empty, at least one allow rule must match.
