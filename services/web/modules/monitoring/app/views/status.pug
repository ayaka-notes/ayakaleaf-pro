extends ../../../../app/views/layout/layout-no-js

block vars
	- metadata = {title: 'Instance status', viewport: true}

block meta
	if grafanaPath
		style.
			html, body {
				height: 100%;
				margin: 0;
			}

			#status-frame {
				display: block;
				width: 100%;
				height: 100vh;
				border: 0;
			}

block body
	if grafanaPath
		body.full-height
			if isolated
				//- Isolated mode: cross-origin Grafana; don't leak the app URL
				//- (or the admin's referrer) to it.
				iframe#status-frame(src=grafanaPath referrerpolicy="no-referrer")
			else
				iframe#status-frame(src=grafanaPath)
	else
		body.full-height
			main#main-content.content.content-alt
				.container
					p Instance status is not configured. Set settings.grafana.public_base_url (isolated embed, recommended) or settings.grafana.internal_url + settings.grafana.admin_password (same-origin proxy).
