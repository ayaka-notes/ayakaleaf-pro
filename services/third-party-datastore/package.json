{
  "name": "@overleaf/third-party-datastore",
  "description": "Syncs Overleaf projects with Dropbox",
  "private": true,
  "type": "module",
  "main": "app.mjs",
  "scripts": {
    "start": "node app.mjs",
    "nodemon": "node --watch app.mjs",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "types:check": "tsc --noEmit"
  },
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@overleaf/access-token-encryptor": "workspace:*",
    "@overleaf/fetch-utils": "workspace:*",
    "@overleaf/logger": "workspace:*",
    "@overleaf/metrics": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/promise-utils": "workspace:*",
    "@overleaf/redis-wrapper": "workspace:*",
    "@overleaf/settings": "workspace:*",
    "body-parser": "1.20.4",
    "bunyan": "^1.8.15",
    "dropbox": "^10.34.0",
    "express": "4.22.1",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^4.16.0",
    "lru-cache": "^4.1.5",
    "mongodb-legacy": "6.1.3",
    "node-fetch": "^2.7.0",
    "p-limit": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "eslint": "^10.4.0",
    "typescript": "^5.0.4"
  }
}
