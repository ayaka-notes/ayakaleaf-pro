+//! CLSI fork addition (D21): capture source locations during PDF export so
+//! that the CLI can emit an `output.sourcemap.json` sidecar (see
+//! `write_clsi_sourcemap` in `typst-cli/src/compile.rs`).
+
+use std::sync::Mutex;
+
+/// A captured source location: a text run placed on a page.
+#[derive(Clone, Copy)]
+pub struct SourceLocation {
+    /// The raw span value; resolved to (file, byte range) in the CLI where
+    /// the world is available.
+    pub span_raw: u64,
+    /// Zero-based index of the exported PDF page.
+    pub page: usize,
+    /// Bounding box in PDF user space (points, origin at the page's
+    /// bottom-left) — matches the coordinates synctex h/v values use.
+    pub x: f32,
+    pub y: f32,
+    pub w: f32,
+    pub h: f32,
+}
+
+/// Collects locations captured during one PDF export.
+///
+/// Interior-mutable, so a plain `&SourceMap` (inside an `Option`, which is
+/// `Copy`) can be threaded through `GlobalContext` without fighting the
+/// borrow checker. PDF export runs on a single thread; the mutex exists for
+/// ergonomics only.
+pub struct SourceMap {
+    pub locations: Mutex<Vec<SourceLocation>>,
+    /// Size of each exported page, in PDF user space units, in page order.
+    pub page_sizes: Mutex<Vec<(f32, f32)>>,
+}
+
+impl Default for SourceMap {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl SourceMap {
+    pub fn new() -> Self {
+        Self {
+            locations: Mutex::new(Vec::new()),
+            page_sizes: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// Records `loc`, saturating at `MAX_LOCATIONS`.
+    pub fn record(&self, loc: SourceLocation) {
+        let Ok(mut guard) = self.locations.lock() else { return };
+        if guard.len() < MAX_LOCATIONS {
+            guard.push(loc);
+        }
+    }
+
+    /// Records the size of one exported page.
+    pub fn record_page(&self, w: f32, h: f32) {
+        let Ok(mut guard) = self.page_sizes.lock() else { return };
+        guard.push((w, h));
+    }
+
+    /// Snapshot of the captured locations (lock is held only briefly).
+    pub fn locations(&self) -> Vec<SourceLocation> {
+        if let Ok(guard) = self.locations.lock() {
+            guard.clone()
+        } else {
+            Vec::new()
+        }
+    }
+
+    /// Snapshot of the per-page sizes, in page order.
+    pub fn page_sizes(&self) -> Vec<(f32, f32)> {
+        if let Ok(guard) = self.page_sizes.lock() {
+            guard.clone()
+        } else {
+            Vec::new()
+        }
+    }
+}
+
+/// Upper bound on the number of recorded locations. Prevents unbounded
+/// growth on very large documents.
+pub const MAX_LOCATIONS: usize = 512_000;
