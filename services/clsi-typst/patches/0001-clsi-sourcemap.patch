+/// CLSI fork (D21): write the `output.sourcemap.json` sidecar next to the
+/// compiled PDF (`output: -` and non-PDF outputs are skipped).
+fn write_clsi_sourcemap(
+    world: &SystemWorld,
+    sourcemap: &typst_pdf::SourceMap,
+    output: &Output,
+) -> std::io::Result<()> {
+    let pdf_path = match output {
+        Output::Path(p) => p.clone(),
+        Output::Stdout => return Ok(()),
+    };
+    if !pdf_path
+        .extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("pdf"))
+    {
+        return Ok(());
+    }
+    let locations = sourcemap_locations(world, sourcemap);
+    let body = serde_json::json!({
+        "typst": "0.15.1+clsi",
+        "pages": sourcemap.page_sizes().len(),
+        // Per-page size in PDF user space (bottom-left origin, y-up) —
+        // the reader uses `[w, h]` per page to flip v to user space.
+        "pageSizes": sourcemap.page_sizes(),
+        "locations": locations,
+    });
+    std::fs::write(pdf_path.with_extension("sourcemap.json"), serde_json::to_string(&body)?)
+}
+
+/// Resolves the raw spans captured during export into (file, byte offset)
+/// pairs via the world and renders the JSON `locations` array.
+fn sourcemap_locations(world: &SystemWorld, sourcemap: &typst_pdf::SourceMap) -> Vec<serde_json::Value> {
+    let mut locations = Vec::new();
+    for loc in sourcemap.locations() {
+        let Some(raw) = std::num::NonZeroU64::new(loc.span_raw) else { continue };
+        let span = Span::from_raw(raw);
+        let file = span.id().map(|id| world.name(id)).unwrap_or_default();
+        let byte_offset = world.range(span).map(|r| r.start as i64).unwrap_or(-1);
+        locations.push(serde_json::json!({
+            "span": { "file": file, "byteOffset": byte_offset },
+            "page": loc.page,
+            "x": loc.x,
+            "y": loc.y,
+            "w": loc.w,
+            "h": loc.h,
+        }));
+    }
+    locations
+}
