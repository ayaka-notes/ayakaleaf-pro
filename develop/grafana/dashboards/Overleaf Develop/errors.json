              },
              {
                "color": "#F2CC0C",
                "value": 1
              },
              {
                "color": "#F2495C",
                "value": 50
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
