    {
      "type": "bargauge",
      "title": "Most frequent error messages",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (service, msg) (count_over_time({service=~\"$service\", level=~\"error|fatal\"} |= \"$search\" | json msg=\"msg\" | msg != \"\" [$__range])))",
          "legendFormat": "{{service}} \u00b7 {{msg}}",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          },
          "noValue": "None",
          "links": [
            {
              "title": "Open ${__field.labels.service}",
              "url": "/d/develop-${__field.labels.service}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 18,
        "maxVizHeight": 26,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "The msg field of the bunyan error and fatal lines, over the time range.",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 12
      }
    },
