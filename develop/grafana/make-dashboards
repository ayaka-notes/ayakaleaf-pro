def service(name, description):
    b, sel = Board(), f'service="{name}"'
    http = f"timer_http_request_count{{{sel}}}"
    b.line([
        kpi("State", f"up{{{sel}}}", "none", steps((None, RED), (1, GREEN)), spark=False, mappings=UP["mappings"]),
        kpi("Uptime", f"time() - process_start_time_seconds{{{sel}}}", "s", steps((None, BLUE)), spark=False, decimals=0),
        kpi("Requests", f"sum(rate({http}[1m]))", "reqps", steps((None, BLUE)), decimals=1),
        kpi("5xx, 1 h", f'sum(increase(timer_http_request_count{{{sel},status_code=~"5.."}}[1h])) or vector(0)', "none",
            steps((None, GREEN), (1, YELLOW), (20, RED)), decimals=0, spark=False),
        kpi("Error logs, 1 h", 'sum(count_over_time({%s, level=~"error|fatal"} [1h]))' % sel, "none",
            steps((None, GREEN), (1, YELLOW), (20, RED)), LOKI, spark=False),
        kpi("Container memory", f"sum(container_memory_working_set_bytes{{{sel}}})", "bytes", steps((None, GREEN), (1e9, YELLOW), (2e9, RED)), decimals=0),
    ], 4)
    b.row("Resources")
    b.line([series("CPU", [(f"rate(process_cpu_seconds_total{{{sel}}}[1m])", "process"),
                           (f"sum(rate(container_cpu_usage_seconds_total{{{sel}}}[1m]))", "container")], "percentunit"),
            series("Memory", [(f"process_resident_memory_bytes{{{sel}}}", "rss"), (f"nodejs_heap_size_used_bytes{{{sel}}}", "heap used"),
                              (f"nodejs_heap_size_total_bytes{{{sel}}}", "heap total")], "bytes")], 8)
    b.line([series("Event loop lag", [(f"nodejs_eventloop_lag_p50_seconds{{{sel}}}", "p50"), (f"nodejs_eventloop_lag_p99_seconds{{{sel}}}", "p99")], "s"),
            series("Garbage collection", [(f"sum by (kind) (rate(nodejs_gc_duration_seconds_sum{{{sel}}}[1m]))", "{{kind}}")], "percentunit",
                   description="Share of time spent in garbage collection.")], 8)
    b.row("HTTP")
    b.line([series("Requests by route", [(f"sum by (method, path) (rate({http}[1m]))", "{{method}} {{path}}")], "reqps"),
            series("Responses by status", [(f"sum by (status_code) (rate({http}[1m]))", "{{status_code}}")], "reqps")], 9)
    b.line([series("Response time by route (p95)", [(f'max by (method, path) (timer_http_request{{{sel},quantile="0.95"}})', "{{method}} {{path}}")], "ms"),
            bars("Busiest routes", [(f"topk(12, sum by (method, path) (increase({http}[$__range])) > 0)", "{{method}} {{path}}")], "none",
                 description="Requests over the time range.")], 9)
    for title, panels, height in extras(name, sel):
        b.row(title)
        b.line(panels, height)
    log_panels(b, "{" + sel + "}")
    return dashboard(f"develop-{name}", name, b, [LEVEL_VAR, SEARCH_VAR], description)


