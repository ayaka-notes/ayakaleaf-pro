    compile_bucket = "sum by (le) (rate(clsi_compile_duration_seconds_bucket[2m]))"
    numbers = [
        kpi("CPU busy", busy, "percentunit", steps((None, GREEN), (0.6, YELLOW), (0.85, RED)), decimals=0),
        kpi("Load per core", f"node_load1 / scalar({cores})", "percentunit", steps((None, GREEN), (0.7, YELLOW), (1, RED)), decimals=0,
