def trend(title, queries, unit, thresholds, maximum=None, total=None):
    """A small time series with axes, for under a big number. thresholds shade
    the warning ranges; total draws that series as a dashed limit line."""
    panel = series(title, queries, unit, legend="hidden")
    defaults = panel["fieldConfig"]["defaults"]
    panel["options"]["legend"] = {"showLegend": False, "displayMode": "list", "placement": "bottom", "calcs": []}
    panel["fieldConfig"]["overrides"] = []
    if thresholds:
        defaults["thresholds"] = thresholds
        defaults["custom"]["thresholdsStyle"] = {"mode": "area"}
        defaults["color"] = {"mode": "fixed", "fixedColor": "text"}
    else:
        defaults["color"] = {"mode": "fixed", "fixedColor": PURPLE if unit == "none" else BLUE}
    if maximum is not None:
        defaults["max"] = maximum
    if total:
        panel["fieldConfig"]["overrides"] = [{"matcher": {"id": "byName", "options": total}, "properties": [
            {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}},
            {"id": "custom.fillOpacity", "value": 0}, {"id": "color", "value": {"mode": "fixed", "fixedColor": RED}}]}]
    return panel


