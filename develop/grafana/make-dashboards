def steps(*pairs):
    return {"mode": "absolute", "steps": [{"color": c, "value": v} for v, c in pairs]}


class Board:
    def __init__(self):
        self.panels, self.y = [], 0

    def add(self, panel, w, h, x=0):
        panel["id"] = len(self.panels) + 1
        panel["gridPos"] = {"x": x, "y": self.y, "w": w, "h": h}
        self.panels.append(panel)

    def row(self, title):
        self.add({"type": "row", "title": title, "collapsed": False, "panels": []}, 24, 1)
        self.y += 1

    def line(self, panels, h):
        """Puts the panels next to each other, with equal widths."""
        w = 24 // len(panels)
        for i, panel in enumerate(panels):
            self.add(panel, w, h, i * w)
        self.y += h


def targets(queries, ds, instant=False):
    out = []
    for i, (expr, legend) in enumerate(queries):
        t = {"refId": chr(65 + i), "datasource": ds, "expr": expr, "legendFormat": legend}
        if instant:
            t.update({"instant": True, "range": False, "queryType": "instant"})
        out.append(t)
    return out


def service_colors():
    return [{"matcher": {"id": "byName", "options": s}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": c}}]}
            for s, c in COLORS.items()]


def series(title, queries, unit, ds=PROM, description=None, stack=False, bars=False, links=None, legend="table"):
    custom = {"lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "lineInterpolation": "smooth",
              "showPoints": "never", "spanNulls": True}
    if bars:
        custom.update({"drawStyle": "bars", "fillOpacity": 70, "gradientMode": "none", "lineWidth": 0})
    if stack:
        custom["stacking"] = {"mode": "normal", "group": "A"}
    defaults = {"unit": unit, "custom": custom, "min": 0}
    if links:
        defaults["links"] = links
    panel = {
        "type": "timeseries", "title": title, "datasource": ds, "targets": targets(queries, ds),
        "fieldConfig": {"defaults": defaults, "overrides": service_colors()},
        "options": {"legend": {"displayMode": legend, "placement": "right" if legend == "table" else "bottom",
                               "calcs": ["lastNotNull", "max"] if legend == "table" else []},
                    "tooltip": {"mode": "multi", "sort": "desc"}},
    }
    if description:
        panel["description"] = description
    return panel


def kpi(title, expr, unit, thresholds, ds=PROM, description=None, spark=True, decimals=None, mappings=None, links=None):
    """One big number with a trend line behind it. Only numbers with a good and a
    bad range (more than one threshold step) get a coloured background."""
    defaults = {"unit": unit, "color": {"mode": "thresholds"}, "thresholds": thresholds, "noValue": "0"}
    if decimals is not None:
        defaults["decimals"] = decimals
    if mappings:
        defaults["mappings"] = mappings
    if links:
        defaults["links"] = links
    panel = {
        "type": "stat", "title": title, "datasource": ds, "targets": targets([(expr, "")], ds),
        "fieldConfig": {"defaults": defaults, "overrides": []},
        "options": {"colorMode": "background" if len(thresholds["steps"]) > 1 else "none",
                    "graphMode": "area" if spark else "none", "textMode": "value",
                    "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False}},
    }
    if description:
        panel["description"] = description
    return panel


def grid(title, expr, legend, defaults, color="background"):
    """One tile per series, laid out in rows."""
    return {
        "type": "stat", "title": title, "datasource": PROM, "targets": targets([(expr, legend)], PROM),
        "fieldConfig": {"defaults": defaults, "overrides": []},
        "options": {"colorMode": color, "graphMode": "none", "textMode": "value_and_name", "orientation": "auto",
                    "minVizWidth": 150, "minVizHeight": 50,
                    "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False}},
    }


def bars(title, queries, unit, ds=PROM, description=None, color=BLUE, links=None):
    """Horizontal bars, one per series, biggest first."""
    defaults = {"unit": unit, "min": 0, "color": {"mode": "fixed", "fixedColor": color}, "noValue": "None"}
    if links:
        defaults["links"] = links
    panel = {
        "type": "bargauge", "title": title, "datasource": ds, "targets": targets(queries, ds, instant=True),
        "fieldConfig": {"defaults": defaults, "overrides": []},
        "options": {"orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "showUnfilled": True,
                    "namePlacement": "left", "sizing": "manual", "minVizHeight": 18, "maxVizHeight": 26,
                    "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False}},
        "transformations": [{"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": True}]}}],
    }
    if description:
        panel["description"] = description
    return panel


def gauge(title, expr, legend, unit, thresholds, maximum, description=None):
    panel = {
        "type": "gauge", "title": title, "datasource": PROM, "targets": targets([(expr, legend)], PROM),
        "fieldConfig": {"defaults": {"unit": unit, "min": 0, "max": maximum, "color": {"mode": "thresholds"},
                                     "thresholds": thresholds}, "overrides": []},
        "options": {"showThresholdLabels": False, "showThresholdMarkers": True,
                    "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False}},
    }
    if description:
        panel["description"] = description
    return panel


def logs(title, expr):
    return {"type": "logs", "title": title, "datasource": LOKI, "targets": [{"refId": "A", "datasource": LOKI, "expr": expr}],
            # showLevel adds the level to each line, showControls the bar on the side
            # of the panel that filters by level, sorts and wraps
            "options": {"showTime": True, "showLevel": True, "showControls": True, "syntaxHighlighting": True,
                        "enableInfiniteScrolling": True, "wrapLogMessage": True, "prettifyLogMessage": False,
                        "enableLogDetails": True, "sortOrder": "Descending", "dedupStrategy": "none"}}


UP = {
    "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": RED}, "1": {"text": "UP", "color": GREEN}}}],
    "color": {"mode": "thresholds"}, "thresholds": steps((None, RED), (1, GREEN)),
}
LEVEL_VAR = {"name": "level", "label": "Log level", "type": "custom", "query": "fatal,error,warn,info,debug,trace",
             "multi": True, "includeAll": True, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
SEARCH_VAR = {"name": "search", "label": "Log search", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
SERVICE_VAR = {"name": "service", "label": "Service", "type": "query", "datasource": LOKI, "query": "label_values(service)",
               "refresh": 2, "multi": True, "includeAll": True, "allValue": ".+", "sort": 1,
               "current": {"text": "All", "value": "$__all"}}
LEVEL_COLORS = [{"matcher": {"id": "byName", "options": n}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": c}}]}
                for n, c in [("fatal", PURPLE), ("error", RED), ("warn", YELLOW), ("info", GREEN), ("debug", BLUE), ("trace", "#8e8e8e")]]


def log_panels(board, selector):
    logq = selector[:-1] + ', level=~"$level"} |= "$search"'
    board.row("Logs")
    lines = series("Log lines", [(f"sum by (level) (count_over_time({logq} [$__interval]))", "{{level}}")], "short", LOKI,
                   stack=True, bars=True, legend="list")
    lines["fieldConfig"]["overrides"] = LEVEL_COLORS
    board.line([lines], 6)
    board.line([logs("Logs", logq)], 20)


def avg(metric, selector, by=""):
    """Mean of a histogram or summary over 5 minutes."""
    by = f" by ({by})" if by else ""
    return f"sum{by} (rate({metric}_sum{{{selector}}}[5m])) / sum{by} (rate({metric}_count{{{selector}}}[5m]))"


def dashboard(uid, title, board, variables, description):
    return {
        "uid": uid, "title": title, "description": description, "tags": [TAG], "links": LINKS,
        "timezone": "browser", "refresh": "10s", "time": {"from": "now-1h", "to": "now"}, "schemaVersion": 39,
        "editable": True, "graphTooltip": 1, "panels": board.panels,
        "templating": {"list": variables}, "annotations": {"list": [RESTARTS]},
    }


def state(sel):
    """up of the Node.js services, with mongo and redis from their exporters, which
    prometheus.yml labels with service="mongo" and service="redis"."""
    return f"up{{job=\"overleaf\",{sel}}} or mongodb_up{{{sel}}} or redis_up{{{sel}}}"


def host_memory(kind):
    """Used memory of the host in GiB; the total comes from node-exporter and sets
    the maximum, so the colours and the gauge follow the share of the total."""
    used = "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes"
    panel = {
        "type": kind, "title": "Memory used", "datasource": PROM,
        "targets": targets([(used, "used"), ("node_memory_MemTotal_bytes", "total")], PROM),
        "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1, "min": 0, "color": {"mode": "thresholds"},
                                     "thresholds": {"mode": "percentage", "steps": [{"color": GREEN, "value": None},
                                                                                    {"color": YELLOW, "value": 75},
                                                                                    {"color": RED, "value": 90}]}},
                        "overrides": []},
        "transformations": [{"id": "configFromData", "options": {"configRefId": "B", "mappings": [
            {"fieldName": "total", "handlerKey": "max"}]}}],
        "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False}},
    }
    if kind == "gauge":
        panel["options"].update({"showThresholdLabels": False, "showThresholdMarkers": True})
    else:
        panel["options"].update({"colorMode": "background", "graphMode": "area", "textMode": "value", "justifyMode": "center"})
    return panel


def all_services():
    b, sel = Board(), 'service=~"$service"'
    http = "timer_http_request_count"
    b.line([
        kpi("Services up", f'count(({state('service!=""')}) == 1)', "none", steps((None, RED), (len(SERVICES) + 3, GREEN)),
            description=f"Of the {len(SERVICES)} Node.js services, git-bridge, mongo and redis."),
        kpi("Requests", f"sum(rate({http}[1m]))", "reqps", steps((None, BLUE)), decimals=1),
        kpi("5xx responses", f'(sum(rate({http}{{status_code=~"5.."}}[5m])) / (sum(rate({http}[5m])) > 0)) or vector(0)',
            "percentunit", steps((None, GREEN), (0.01, YELLOW), (0.05, RED)), decimals=1,
            links=[{"title": "Open Errors", "url": "/d/develop-errors/errors?${__url_time_range}"}]),
        kpi("Error logs, 5 min", 'sum(count_over_time({service=~".+", level=~"error|fatal"} [5m]))', "none",
            steps((None, GREEN), (1, YELLOW), (20, RED)), LOKI,
            links=[{"title": "Open Errors", "url": "/d/develop-errors/errors?${__url_time_range}"}]),
        kpi("Active users", 'max(num_active_users{service="web"})', "none", steps((None, PURPLE)),
            description="Users seen by web in the last hour."),
        kpi("Containers", 'count(container_memory_working_set_bytes{service!="", service!="compile"})', "none", steps((None, BLUE)), spark=False,
            description="Containers of the development environment, without the sandboxed compiles."),
        kpi("CPU, all containers", 'sum(rate(container_cpu_usage_seconds_total{service!=""}[1m]))', "percentunit",
            steps((None, GREEN), (4, YELLOW), (7, RED)), description="100% is one core.", decimals=0),
        kpi("Memory, all containers", 'sum(container_memory_working_set_bytes{service!=""})', "bytes",
            steps((None, GREEN), (16e9, YELLOW), (24e9, RED)), decimals=1),
    ], 4)
    b.row("Services")
    # One click on a tile opens the dashboard of that service
    up = dict(UP, links=[dict(SERVICE_LINK, oneClick=True)])
    b.add(grid("State", state(sel), "{{service}}", up), 12, 8)
    cores = 'count(node_cpu_seconds_total{mode="idle"})'
    to_server = [{"title": "Open Server", "url": "/d/develop-server/server?${__url_time_range}"}]
    host = [
        gauge("CPU busy", f'1 - sum(rate(node_cpu_seconds_total{{mode="idle"}}[1m])) / {cores}', "", "percentunit",
              steps((None, GREEN), (0.6, YELLOW), (0.85, RED)), 1),
        gauge("Load per core", f"node_load1 / scalar({cores})", "", "percentunit", steps((None, GREEN), (0.7, YELLOW), (1, RED)), 2,
              "The 1 minute load average divided by the number of cores."),
        host_memory("gauge"),
        kpi("Compiles per minute", "sum(rate(clsi_compiles_total[1m])) * 60", "none", steps((None, PURPLE)), decimals=1),
    ]
    # 2 x 2 next to State
    for i, panel in enumerate(host):
        panel["links"] = to_server
        b.add(panel, 6, 4, 12 + 6 * (i % 2))
        b.panels[-1]["gridPos"]["y"] = b.y + 4 * (i // 2)
    b.y += 8
    b.row("Resources")
    b.line([series("CPU", [(f"rate(process_cpu_seconds_total{{{sel}}}[1m])", "{{service}}")], "percentunit", links=[SERVICE_LINK]),
            series("Memory (RSS)", [(f"process_resident_memory_bytes{{{sel}}}", "{{service}}")], "bytes", links=[SERVICE_LINK])], 8)
    b.line([series("Heap used", [(f"nodejs_heap_size_used_bytes{{{sel}}}", "{{service}}")], "bytes", links=[SERVICE_LINK]),
            series("Event loop lag (p99)", [(f"nodejs_eventloop_lag_p99_seconds{{{sel}}}", "{{service}}")], "s", links=[SERVICE_LINK])], 8)
    b.row("HTTP")
    b.line([series("Requests", [(f"sum by (service) (rate({http}{{{sel}}}[1m]))", "{{service}}")], "reqps", links=[SERVICE_LINK]),
            series("5xx responses", [(f'sum by (service) (rate({http}{{{sel},status_code=~"5.."}}[5m]))', "{{service}}")], "reqps", links=[SERVICE_LINK]),
            series("Response time (p95)", [(f'max by (service) (timer_http_request{{{sel},quantile="0.95"}})', "{{service}}")], "ms", links=[SERVICE_LINK])], 8)
    log_panels(b, '{service=~"$service"}')
    return dashboard("develop", "All services", b, [SERVICE_VAR, LEVEL_VAR, SEARCH_VAR],
                     "State, load and logs of every service of the development environment.")


def errors():
    b = Board()
    err = '{service=~"$service", level=~"error|fatal"} |= "$search"'
    http5 = 'timer_http_request_count{service=~"$service",status_code=~"5.."}'
    http4 = 'timer_http_request_count{service=~"$service",status_code=~"4.."}'
    b.line([
        kpi("Error logs", f"sum(count_over_time({err} [$__range]))", "none", steps((None, GREEN), (1, YELLOW), (50, RED)), LOKI, spark=False),
        kpi("Fatal logs", 'sum(count_over_time({service=~"$service", level="fatal"} [$__range]))', "none", steps((None, GREEN), (1, RED)), LOKI, spark=False),
        kpi("5xx responses", f"sum(increase({http5}[$__range])) or vector(0)", "none", steps((None, GREEN), (1, YELLOW), (50, RED)), decimals=0, spark=False),
        kpi("4xx responses", f"sum(increase({http4}[$__range])) or vector(0)", "none", steps((None, BLUE)), decimals=0, spark=False),
    ], 4)
    b.row("Where")
    b.line([series("Error logs by service", [(f"sum by (service) (count_over_time({err} [$__interval]))", "{{service}}")], "short", LOKI,
                   stack=True, bars=True, links=[SERVICE_LINK]),
            series("5xx responses by service", [(f"sum by (service) (increase({http5}[$__rate_interval]))", "{{service}}")], "short",
                   stack=True, bars=True, links=[SERVICE_LINK])], 8)
    b.row("What")
    b.line([bars("Most frequent error messages",
                 [(f'topk(15, sum by (service, msg) (count_over_time({err} | json msg="msg" | msg != "" [$__range])))', "{{service}} · {{msg}}")],
                 "none", LOKI, "The msg field of the bunyan error and fatal lines, over the time range.", RED, [SERVICE_LINK]),
            bars("Routes that return 5xx",
                 [(f"topk(15, sum by (service, method, path, status_code) (increase({http5}[$__range])) > 0)", "{{service}} · {{method}} {{path}} · {{status_code}}")],
                 "none", description="Over the time range. path is the route name that the service gives to its metrics.", color=RED, links=[SERVICE_LINK])], 12)
    b.line([bars("Routes that return 4xx",
                 [(f"topk(15, sum by (service, method, path, status_code) (increase({http4}[$__range])) > 0)", "{{service}} · {{method}} {{path}} · {{status_code}}")],
                 "none", color=YELLOW, links=[SERVICE_LINK]),
            series("Warnings by service", [('sum by (service) (count_over_time({service=~"$service", level="warn"} |= "$search" [$__interval]))', "{{service}}")],
                   "short", LOKI, stack=True, bars=True, links=[SERVICE_LINK])], 9)
    b.row("Logs")
    b.line([logs("Error and fatal logs", err)], 22)
    return dashboard("develop-errors", "Errors", b, [SERVICE_VAR, SEARCH_VAR],
                     "Error logs and failed requests of every service, in one place.")


def data_flow():
    b = Board()
    du, ph, hv = 'service="document-updater"', 'service="project-history"', 'service="history-v1"'
    b.row("Editor to Redis: document-updater")
    b.line([series("Pending updates per flush", [(avg("histogram_redis_pendingUpdates_llen", du, "path"), "{{path}}")], "short",
                   description="Mean length of the pending updates list in Redis each time document-updater reads it."),
            series("Loading a doc", [(f'max(timer_redis_get_doc{{{du},quantile="0.95"}})', "from Redis, p95"),
                                     (f'max(timer_http_getDoc{{{du},quantile="0.95"}})', "from web and docstore, p95")], "ms"),
            series("Doc size in Redis", [(f'max(redis_docLines{{{du},quantile="0.95"}})', "p95"), (f'max(redis_docLines{{{du},quantile="0.5"}})', "p50")], "bytes")], 8)
    b.row("Redis to history: project-history")
    b.line([series("Projects waiting for a flush", [(f"max(queued_projects{{{ph}}})", "queued projects"), (f"max(max_queue_size{{{ph}}})", "longest queue")], "short",
                   description="project-history processes a project every 500 ops, on an unload, by a cron or on a read that flushes first."),
            series("Flush", [(avg("history_flush_duration_seconds", ph), "mean duration")], "s"),
            series("Updates per flush", [(avg("history_flush_queue_size", ph), "mean queue size")], "short"),
            series("Flush attempts", [(f"max(attempts{{{ph}}})", "attempts"), (f"max(failed{{{ph}}})", "failed"), (f"max(requests{{{ph}}})", "requests")], "short")], 8)
    b.row("history-v1")
    b.line([series("Reading changes", [(f"sum(rate(chunk_store_redis_get_non_persisted_changes{{{hv}}}[5m]))", "not yet persisted, from Redis"),
                                       (f"sum(rate(chunk_store_redis_get_changes_since_version{{{hv}}}[5m]))", "since a version, from Redis"),
                                       (f"sum(rate(chunk_store_get_changes_since_version{{{hv}}}[5m]))", "since a version")], "ops"),
            series("Requests by route", [(f"sum by (method, path) (rate(timer_http_request_count{{{hv}}}[1m]))", "{{method}} {{path}}")], "reqps")], 8)
    b.row("Mongo, as the services see it")
    b.line([series("Commands by service", [("sum by (service) (rate(mongo_command_started[1m]))", "{{service}}")], "ops", links=[SERVICE_LINK]),
            series("Commands by collection", [("sum by (collection, method) (rate(mongo_command_started[1m]))", "{{collection}} {{method}}")], "ops"),
            series("Command time (mean)", [(avg("mongo_command_time", "", "service"), "{{service}}")], "ms", links=[SERVICE_LINK])], 9)
    b.line([series("Connections in use", [("mongo_connection_pool_size - mongo_connection_pool_available", "{{service}}")], "short", links=[SERVICE_LINK]),
            series("Requests waiting for a connection", [("mongo_connection_pool_waiting", "{{service}}")], "short", links=[SERVICE_LINK])], 7)
    b.row("Object storage: filestore and history-v1")
    b.line([series("Reads by bucket", [("sum by (service, bucket) (rate(s3_ingress[1m]))", "{{service}} · {{bucket}}")], "Bps",
                   description="Bytes read from the object store, RustFS when S3_ENABLED is on."),
            series("Read latency", [(avg("histogram_s3_ingress_latency", "", "service"), "{{service}}, whole read"),
                                    (avg("histogram_s3_ingress_latency_first_byte", "", "service"), "{{service}}, first byte")], "ms")], 8)
    return dashboard("develop-data-flow", "Data flow", b, [],
                     "The path of an edit: document-updater and Redis, project-history, history-v1, Mongo and the object store.")


def git_bridge():
    """git-bridge is Java: JVM metrics, no HTTP request metrics."""
    b, sel = Board(), 'service="git-bridge"'
    heap = f'jvm_memory_bytes_used{{{sel},area="heap"}}'
    b.line([
        kpi("State", f"up{{{sel}}}", "none", steps((None, RED), (1, GREEN)), spark=False, mappings=UP["mappings"]),
        kpi("Uptime", f"time() - process_start_time_seconds{{{sel}}}", "s", steps((None, BLUE)), spark=False, decimals=0),
        kpi("Heap used", f'{heap} / jvm_memory_bytes_max{{{sel},area="heap"}}', "percentunit",
            steps((None, GREEN), (0.75, YELLOW), (0.9, RED)), decimals=0),
        kpi("Threads", f"jvm_threads_current{{{sel}}}", "none", steps((None, BLUE))),
        kpi("Time in GC", f"sum(rate(jvm_gc_collection_seconds_sum{{{sel}}}[1m]))", "percentunit",
            steps((None, GREEN), (0.05, YELLOW), (0.2, RED)), decimals=1),
        kpi("Error logs, 1 h", 'sum(count_over_time({%s, level=~"error|fatal"} [1h]))' % sel, "none",
            steps((None, GREEN), (1, YELLOW), (20, RED)), LOKI, spark=False),
    ], 4)
    b.row("Resources")
    b.line([series("CPU", [(f"rate(process_cpu_seconds_total{{{sel}}}[1m])", "process"),
                           (f"sum(rate(container_cpu_usage_seconds_total{{{sel}}}[1m]))", "container")], "percentunit"),
