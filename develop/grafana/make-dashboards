        kpi("Compiles per minute", "sum(rate(clsi_compiles_total[1m])) * 60", "none", steps((None, PURPLE)), decimals=1),
        kpi("Compile time, p95", f"histogram_quantile(0.95, {compile_bucket})", "s", steps((None, GREEN), (10, YELLOW), (30, RED)), decimals=1),
        kpi("Failed compiles, 5 min", 'sum(increase(clsi_compiles_total{status!="success"}[5m])) or vector(0)', "none",
            steps((None, GREEN), (1, YELLOW), (10, RED)), decimals=0),
