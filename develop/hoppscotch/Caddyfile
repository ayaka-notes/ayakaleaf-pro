# The selfhost-web.Caddyfile of hoppscotch/hoppscotch-frontend:2026.10.0, plus
# Proxyscotch on /proxy. Compare with the image's file when upgrading.
{
  admin off
  persist_config off
}

:{$HOPP_ALTERNATE_PORT:80} :3000 {
	# Proxyscotch on the page's own address, so that requests to the services,
	# like http://web:3000, need no other port
	handle_path /proxy* {
		reverse_proxy hoppscotch-proxy:9159
	}

	handle {
		try_files {path} /
		root * /site/selfhost-web
		file_server
	}
}
