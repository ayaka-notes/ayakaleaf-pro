# Apprise notification bridge — SMTP defaults for the mailto channel.
# Copy to .env and fill in your values. All variables are optional;
# without SMTP_PASS the mailto channel will not authenticate.

SMTP_HOST=smtp.uni-bremen.de
SMTP_PORT=465
SMTP_FROM=overleaf@uni-bremen.de
SMTP_USER=overleaf
SMTP_PASS=
# ssl (port 465) | starttls (port 587) | insecure (port 25)
SMTP_MODE=ssl
