# =============================================================================
# prometheus-probe-grafana — environment sample
# Copy to `.env` next to compose.yaml and adjust. Compose interpolates every
# ${VAR} in compose.yaml from this file. (prometheus/prometheus.yml is NOT
# interpolated — edit its target names directly if they differ.)
# =============================================================================

# ----- what to monitor (names reachable on the network) ---------------------
# Defaults match an Overleaf deployment's service names on the same network.
# If you join the deployment's own network (see NETWORK_* below), these are
# the deployment's container/DNS names.
MONGO_HOSTNAME=mongo
MONGO_PORT=27017
MONGODB_DATABASE=sharelatex
REDIS_HOSTNAME=redis
REDIS_PORT=6379
# The Overleaf web process's own /metrics (job overleaf-web)
OVERLEAF_HOSTNAME=overleaf
OVERLEAF_METRICS_PORT=3000
# SeaweedFS master native prometheus (job overleaf-filestore). Remove the job
# from prometheus.yml if your stack has no SeaweedFS.
SEAWEEDFS_MASTER_HOSTNAME=seaweedfs-master
SEAWEEDFS_MASTER_METRICS_PORT=9327
# Image used by the mongo-probe sidecar (must speak to your mongo)
MONGO_VERSION=9.0

# ----- network ----------------------------------------------------------------
# Default: this tool creates its own bridge network and everything runs in it.
# To join an EXISTING deployment network (e.g. the Overleaf compose project,
# so the exporters can reach mongo/redis/overleaf by their names):
#   NETWORK_NAME=overleaf-network
#   NETWORK_EXTERNAL=true
NETWORK_NAME=prometheus-probe-grafana
NETWORK_EXTERNAL=false

# ----- published ports ---------------------------------------------------------
# Prometheus binds 127.0.0.1 by default (SSH-tunnel / admin access).
PROMETHEUS_HOST_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_BIND=0.0.0.0
GRAFANA_HOST_PORT=3000

# ----- images / retention -------------------------------------------------------
PROMETHEUS_IMAGE=prom/prometheus:v2.53.5
PROMETHEUS_RETENTION=15d
PROMETHEUS_STACK_LABEL=overleaf-cep
GRAFANA_IMAGE=grafana/grafana-oss:11.6.0
MONGODB_EXPORTER_IMAGE=percona/mongodb_exporter:0.43.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.58.0-alpine
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
PROBE_IMAGE=busybox:1.36

# ----- Grafana -------------------------------------------------------------------
# REQUIRED: the compose file refuses to start without it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-me>
# Honored only when Grafana CREATES the admin (fresh grafana-data volume).
GRAFANA_ADMIN_EMAIL=admin@localhost
# Subpath serving behind a reverse proxy (e.g. https://site/grafana/):
#   GRAFANA_ROOT_URL=https://<site>/grafana/
#   GRAFANA_SERVE_FROM_SUB_PATH=true
#   (and set the grafana job metrics_path in prometheus.yml to /grafana/metrics)
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVE_FROM_SUB_PATH=false
# Optional SMTP (Grafana reset-password mail). Disabled by default.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_SKIP_VERIFY=false

# ----- instance-sensor -------------------------------------------------------------
# Image tag for the locally built sensor (docker compose build)
INSTANCE_SENSOR_IMAGE=overleaf-instance-sensor:local
# 'true' -> adds the standard/guest user split (guest = 'guest-user' in
# users.adminRoles, the PR#176 definition)
INSTANCE_STATS_SEGMENTATION=false
# Active window for the users/projects active gauges (also emitted as the
# window_hours="…" label)
ACTIVE_WINDOW_HOURS=24
# Host path of the SeaweedFS/S3 filestore data dir (mounted read-only into
# the sensor at /hostdata/filestore, where it runs a byte-exact du).
# Default /dev/null → the filestore component reports 0 bytes (stacks without
# a filestore). Overleaf deployment example:
#   FILESTORE_HOST_DIR=/data_1/docker/compose/seaweedfs-volume/data
FILESTORE_HOST_DIR=
# Probe / collect timeouts (ms)
PROBE_TIMEOUT_MS=8000
COLLECT_TIMEOUT_MS=20000

# Grafana 11.6 has no live_enabled setting; max_connections=0 disables
# Grafana Live (websocket push) entirely — the Overleaf admin-UI proxy is
# HTTP-only, so disable Live when serving the embed.
# GF_LIVE_MAX_CONNECTIONS=0
