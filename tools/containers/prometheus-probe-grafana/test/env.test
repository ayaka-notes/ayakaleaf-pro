# Track A test env — template. run.sh copies this to .env and substitutes
# __FILESTORE__ and appends INSTANCE_SENSOR_IMAGE.
#
# Joins the fixture network created by fixture-compose.yaml (where mongo/redis
# are aliased by name), so all MONGO_*/REDIS_* defaults stay at their defaults.
NETWORK_NAME=ppb-test
NETWORK_EXTERNAL=true
MONGODB_DATABASE=sharelatex
FILESTORE_HOST_DIR=__FILESTORE__
INSTANCE_STATS_SEGMENTATION=true
ACTIVE_WINDOW_HOURS=6
# Ports offset from the defaults so the test can run even if a live stack is
# partially back up.
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ppb-test-password
