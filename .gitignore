# docker image build
.dockerignore

# user defined files
.env
docker-compose.override.yml

# Yarn PnP build artifacts — regenerated by `yarn install` (the Dockerfile runs it);
# must NOT be committed (was accidentally committed before, ~1.9 GB)
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.cjs
.pnp.loader.mjs

# test runner caches
.vite/
**/node_modules/.vite/
