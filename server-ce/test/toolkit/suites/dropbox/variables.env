# Dropbox sync against services/dropbox-mock, which answers as the Dropbox
# hosts the SDK derives from DROPBOX_API_DOMAIN. Its bin/prepare fills in the
# app key and secret and the token cipher password.
DROPBOX_ENABLED=true
DROPBOX_API_DOMAIN=dropbox.example.com
DROPBOX_APP_NAME=Overleaf E2E

# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/dropbox-mock-ca.pem
# The docs ask for git-bridge first; without it the settings hide the
# project sync widgets
GIT_BRIDGE_ENABLED=true
