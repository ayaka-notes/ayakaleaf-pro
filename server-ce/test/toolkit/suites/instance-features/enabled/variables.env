# Every feature /system/features reports, turned on. Nothing is called, so
# the AI gateway and the GitHub, GitLab, Gitea and Dropbox apps are
# placeholders.
AI_ENABLED=true
AI_BASE_URL=https://ai.example.com/v1
AI_API_KEY=e2e-placeholder
AI_MODEL=e2e-model
GITHUB_SYNC_ENABLED=true
GITHUB_SYNC_CLIENT_ID=e2e-placeholder
GITHUB_SYNC_CLIENT_SECRET=e2e-placeholder
# No token is stored in this suite, the cipher only has to exist
GITHUB_TOKEN_CIPHER_PASSWORD=e2e-placeholder-cipher-password-0123456789
GITLAB_SYNC_ENABLED=true
GITLAB_SYNC_CLIENT_ID=e2e-placeholder
GITLAB_SYNC_CLIENT_SECRET=e2e-placeholder
GITLAB_TOKEN_CIPHER_PASSWORD=e2e-placeholder-cipher-password-0123456789
GITEA_SYNC_ENABLED=true
GITEA_SYNC_CLIENT_ID=e2e-placeholder
GITEA_SYNC_CLIENT_SECRET=e2e-placeholder
GITEA_TOKEN_CIPHER_PASSWORD=e2e-placeholder-cipher-password-0123456789
DROPBOX_ENABLED=true
DROPBOX_APP_KEY=e2e-placeholder
DROPBOX_APP_SECRET=e2e-placeholder
DROPBOX_TOKEN_CIPHER_PASSWORD=e2e-placeholder-cipher-password-0123456789
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file,url,zotero,mendeley
