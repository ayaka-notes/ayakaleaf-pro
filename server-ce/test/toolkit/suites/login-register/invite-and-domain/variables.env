# Addresses of example.com sign up with an activation email, and the invites of
# its users let any address sign up
OVERLEAF_ALLOW_PUBLIC_REGISTRATION=@example.com,invite@example.com

# Invites and activation emails go through Mailpit (services/mailpit)
OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
OVERLEAF_EMAIL_SMTP_HOST=mailpit
OVERLEAF_EMAIL_SMTP_PORT=1025
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true
