# reCAPTCHA on login, register and password reset, checked against
# services/recaptcha-mock, which answers as www.google.com
RECAPTCHA_SITE_KEY=e2e-recaptcha-site-key
RECAPTCHA_SECRET_KEY=e2e-recaptcha-secret
CAPTCHA_TRUSTED_USERS=trusted-captcha@example.com
# Remember the devices that solved a captcha, so their next login skips it
DEVICE_HISTORY_SECRET=6f8c2b1e9a7d4c3b5e0f1a2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6e5f4a3
# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/recaptcha-mock-ca.pem

# Back to sign up with email and password after the domain variants
OVERLEAF_ALLOW_PUBLIC_REGISTRATION=true

# Password reset emails go to Mailpit (services/mailpit)
OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
OVERLEAF_EMAIL_SMTP_HOST=mailpit
OVERLEAF_EMAIL_SMTP_PORT=1025
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true
