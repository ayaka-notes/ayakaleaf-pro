# Two entries, the second for subdomains only, with spaces after the comma
OVERLEAF_ALLOW_PUBLIC_REGISTRATION=@example.com, @*.uni.test

# Sign ups get their activation email through Mailpit (services/mailpit)
OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
OVERLEAF_EMAIL_SMTP_HOST=mailpit
OVERLEAF_EMAIL_SMTP_PORT=1025
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true
