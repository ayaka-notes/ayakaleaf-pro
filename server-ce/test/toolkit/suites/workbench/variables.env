# The AI gateway, web search and documentation search against
# services/ai-mock, which answers as api.openai.com, api.tavily.com and
# docs.overleaf.com on the toolkit's network. Its bin/prepare fills in
# AI_API_KEY and TAVILY_API_KEY. DOCS_MCP_URL keeps its default.
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=e2e-model
AI_IMAGE_MODEL=e2e-vision-model
# Low enough for a test to reach
AI_MAX_STEPS=3
AI_TOKEN_QUOTA=100000
# The token quota counts through the rate limiters, keep them on
E2E_DISABLE_RATE_LIMITS=false

# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/ai-mock-ca.pem
