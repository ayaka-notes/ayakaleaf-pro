# Gitea Sync against services/gitea, a real Gitea at http://gitea:3000 on the
# toolkit's network. Its bin/prepare fills in the OAuth client and the token
# cipher password.
GITEA_SYNC_ENABLED=true
GITEA_SYNC_URL=http://gitea:3000
# Set, so that the suite covers reading it from the environment
GITEA_API_MAX_CONCURRENCY=5
