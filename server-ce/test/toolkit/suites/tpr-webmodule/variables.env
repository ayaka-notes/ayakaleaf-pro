# Zotero and Mendeley against services/tpr-mock, which answers as
# www.zotero.org, api.zotero.org and api.mendeley.com on the toolkit's
# network. Its bin/prepare fills in the OAuth clients.
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file,url,zotero,mendeley

# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/tpr-mock-ca.pem
