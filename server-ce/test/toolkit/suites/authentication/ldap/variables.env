# LDAP login against the LDAP outpost of services/authentik, see the docs:
# https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/authentication/ldap-authentication
EXTERNAL_AUTH=ldap
OVERLEAF_LDAP_IDENTITY_SERVICE_NAME=LDAP login
OVERLEAF_LDAP_URL=ldap://authentik-ldap:3389
OVERLEAF_LDAP_BIND_DN=cn=ldapservice,ou=users,dc=ayakaleaf,dc=test
# Filled in by services/authentik/bin/prepare with this run's password
OVERLEAF_LDAP_BIND_CREDENTIALS=
OVERLEAF_LDAP_SEARCH_BASE=ou=users,dc=ayakaleaf,dc=test
OVERLEAF_LDAP_SEARCH_FILTER=(cn={{username}})
OVERLEAF_LDAP_EMAIL_ATT=mail
OVERLEAF_LDAP_NAME_ATT=name
OVERLEAF_LDAP_IS_ADMIN_ATT=memberOf
OVERLEAF_LDAP_IS_ADMIN_ATT_VALUE=cn=Admins,ou=groups,dc=ayakaleaf,dc=test
OVERLEAF_LDAP_UPDATE_USER_DETAILS_ON_LOGIN=true
