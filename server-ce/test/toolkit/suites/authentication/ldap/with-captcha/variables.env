# reCAPTCHA on the LDAP login, checked against services/recaptcha-mock, which
# answers as www.google.com
RECAPTCHA_SITE_KEY=e2e-recaptcha-site-key
RECAPTCHA_SECRET_KEY=e2e-recaptcha-secret
# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/recaptcha-mock-ca.pem
