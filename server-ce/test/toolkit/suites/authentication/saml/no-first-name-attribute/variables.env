# A first name attribute the IdP does not send, the last name from the full name
OVERLEAF_SAML_FIRST_NAME_FIELD=not-sent-by-the-idp
OVERLEAF_SAML_LAST_NAME_FIELD=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
# Back on after the no-admin-mapping variant: the case reads the logs as alice
OVERLEAF_SAML_IS_ADMIN_FIELD=http://schemas.xmlsoap.org/claims/Group
OVERLEAF_SAML_IS_ADMIN_FIELD_VALUE=Admins
