# OIDC login against services/authentik, see the docs:
# https://ayakaleaf-pro.ayaka.space/on-premises/configuration/overleaf-toolkit/authentication/oidc-authentication
EXTERNAL_AUTH=oidc
OVERLEAF_OIDC_PROVIDER_ID=authentik
OVERLEAF_OIDC_IDENTITY_SERVICE_NAME=OIDC login
OVERLEAF_OIDC_ISSUER=http://authentik:9000/application/o/ayakaleaf-oidc/
OVERLEAF_OIDC_AUTHORIZATION_URL=http://authentik:9000/application/o/authorize/
OVERLEAF_OIDC_TOKEN_URL=http://authentik:9000/application/o/token/
OVERLEAF_OIDC_USER_INFO_URL=http://authentik:9000/application/o/userinfo/
OVERLEAF_OIDC_LOGOUT_URL=http://authentik:9000/application/o/ayakaleaf-oidc/end-session/
# Same as E2E_OIDC_CLIENT_ID in services/authentik/authentik.env
OVERLEAF_OIDC_CLIENT_ID=overleaf
# Filled in by services/authentik/bin/prepare with this run's secret
OVERLEAF_OIDC_CLIENT_SECRET=
OVERLEAF_OIDC_USER_ID_FIELD=username
OVERLEAF_OIDC_IS_ADMIN_FIELD=groups
OVERLEAF_OIDC_IS_ADMIN_FIELD_VALUE=Admins
OVERLEAF_OIDC_UPDATE_USER_DETAILS_ON_LOGIN=true
