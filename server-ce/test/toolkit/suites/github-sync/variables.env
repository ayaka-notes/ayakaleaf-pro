# GitHub Sync against services/github-mock, which answers as github.com and
# api.github.com on the toolkit's network. Its bin/prepare fills in the OAuth
# client and the token cipher password.
GITHUB_SYNC_ENABLED=true
# Set, so that the suite covers reading it from the environment
GITHUB_API_MAX_CONCURRENCY=5

# Trust the mock's throwaway CA, written by its bin/prepare
NODE_EXTRA_CA_CERTS=/var/lib/overleaf/certs/github-mock-ca.pem
