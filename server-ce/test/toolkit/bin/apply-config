#!/usr/bin/env bash
# Usage: bin/apply-config TARGET OVERRIDES
#
# Sets every KEY=VALUE line from OVERRIDES in TARGET the way a user edits a
# toolkit config file: replace the existing (possibly commented out) KEY= line,
# or append it when TARGET has no such line. A '#KEY=' line (no space after
# the '#') comments KEY out again, e.g. a variant that turns off a setting of
# an earlier one.

set -euo pipefail

target=$1
overrides=$2

while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" ]] && continue
  if [[ "$line" =~ ^#([A-Z0-9_]+)=$ ]]; then
    key=${BASH_REMATCH[1]}
    program='$0 ~ "^" key "=" { print "#" $0; next } { print }'
  else
    [[ "$line" == \#* ]] && continue
    key=${line%%=*}
    program='
      !done && $0 ~ "^#? *" key "=" { print line; done = 1; next }
      { print }
      END { if (!done) print line }
    '
  fi
  tmp=$(mktemp)
  awk -v key="$key" -v line="$line" "$program" "$target" >"$tmp"
  cat "$tmp" >"$target"
  rm "$tmp"
done <"$overrides"
