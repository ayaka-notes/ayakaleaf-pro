# Applied on top of the variables.env that toolkit's bin/init generates.
# A suite can layer more settings via suites/<suite>/variables.env.

# The Cypress container reaches the instance as http://sharelatex
OVERLEAF_SITE_URL=http://sharelatex

# Reject breached passwords, same as develop/dev.env
HAVE_I_BEEN_PWNED_ENABLED=true

# Small TeX Live image instead of the ~9GB texlive-full
TEX_LIVE_DOCKER_IMAGE=ghcr.io/ayaka-notes/texlive-basic:2026.1
ALL_TEX_LIVE_DOCKER_IMAGES=ghcr.io/ayaka-notes/texlive-basic:2026.1
