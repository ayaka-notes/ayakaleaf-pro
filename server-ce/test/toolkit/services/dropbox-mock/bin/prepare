#!/usr/bin/env bash
# Usage: services/dropbox-mock/bin/prepare
#
# Runs before the toolkit's bin/up. Into $TOOLKIT_DIR/services/dropbox-mock/
# it writes a throwaway CA, a certificate for the Dropbox hosts the SDK
# derives from DROPBOX_API_DOMAIN=dropbox.example.com, signed by it, and a
# random app secret. The CA goes into data/overleaf/certs/, where the
# suite's NODE_EXTRA_CA_CERTS points, and the secrets into the toolkit's
# variables.env.
#
# Expects TOOLKIT_DIR in the environment.

set -euo pipefail

services="$(cd "$(dirname "$0")/../.." && pwd)"
state="$TOOLKIT_DIR/services/dropbox-mock"

"$services/lib/make-tls" "$state" \
  api-dropbox.example.com \
  api-content-dropbox.example.com \
  meta-dropbox.example.com
mkdir -p "$TOOLKIT_DIR/data/overleaf/certs"
cp "$state/ca.crt" "$TOOLKIT_DIR/data/overleaf/certs/dropbox-mock-ca.pem"

app_secret=$(openssl rand -hex 20)
cat >"$state/mock.env" <<ENV
DROPBOX_MOCK_APP_KEY=e2e-dropbox-app
DROPBOX_MOCK_APP_SECRET=$app_secret
ENV

"$services/../bin/apply-config" "$TOOLKIT_DIR/config/variables.env" <(cat <<ENV
DROPBOX_APP_KEY=e2e-dropbox-app
DROPBOX_APP_SECRET=$app_secret
DROPBOX_TOKEN_CIPHER_PASSWORD=$(openssl rand -hex 24)
ENV
)
