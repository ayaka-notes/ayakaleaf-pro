#!/usr/bin/env bash
# Usage: services/mailpit/bin/up
#
# Runs after the toolkit's bin/up, once its network exists. Starts Mailpit as
# mailpit: SMTP on 1025 for Overleaf, the API on 8025 for the tests. Chaos is
# enabled, so that tests can make the SMTP server refuse emails
# (PUT /api/v1/chaos).
#
# Expects TOOLKIT_NETWORK in the environment.

set -euo pipefail

docker run --detach --name "${CONTAINER_PREFIX:-e2e-}mailpit" \
  --network "$TOOLKIT_NETWORK" \
  --network-alias mailpit \
  --env MP_ENABLE_CHAOS=true \
  axllent/mailpit:v1.31.3

echo "Waiting for mailpit..."
for _ in $(seq 30); do
  docker exec "${CONTAINER_PREFIX:-}sharelatex" curl -sf -o /dev/null http://mailpit:8025/api/v1/info && exit 0
  sleep 1
done
echo "mailpit did not start" >&2
exit 1
