# Settings of the e2e authentik that are not secret. The secrets are generated
# per run by bin/prepare into $TOOLKIT_DIR/services/authentik/secrets.env.
AUTHENTIK_POSTGRESQL__HOST=authentik-postgresql
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# Read by blueprint.yaml
E2E_OVERLEAF_URL=http://sharelatex
E2E_OIDC_CLIENT_ID=overleaf
